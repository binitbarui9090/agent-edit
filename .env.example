# Copy to .env. No secrets are required for local development in Phase 1.
NODE_ENV=development
LOG_LEVEL=info

# API
API_HOST=127.0.0.1
API_PORT=4000
# Browser origin allowed to make state-changing requests.
WEB_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API. 0 when exposed directly.
TRUST_PROXY_HOPS=0
SESSION_TTL_DAYS=30

# Infrastructure (see docker-compose.yml)
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=agent_edit
REDIS_URL=redis://127.0.0.1:6380

# S3-compatible object storage (see docker-compose.yml)
S3_ENDPOINT=http://127.0.0.1:8333
# Endpoint presigned URLs point at. It must be reachable from the browser.
S3_PUBLIC_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=agent-edit
S3_ACCESS_KEY_ID=agent-edit-dev
S3_SECRET_ACCESS_KEY=agent-edit-dev-secret

# AI providers. Each is chosen independently, and 'none' turns that capability off honestly:
# without a language model the agent falls back to labelled rule-based planning.
# SPEECH_PROVIDER: none | whisper (local, free) | deepgram (paid, identifies speakers) | mock
# LLM_PROVIDER: none | ollama (local, free) | anthropic (paid) | mock
# VISION_PROVIDER: none | ollama | anthropic
SPEECH_PROVIDER=none
LLM_PROVIDER=none
VISION_PROVIDER=none
# npm run setup:whisper downloads a model to the default location.
# WHISPER_MODEL_PATH=~/.cache/agent-edit/whisper/ggml-base.en.bin
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_VISION_MODEL=gemma3:4b
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# DEEPGRAM_API_KEY=

# Uploads and processing
MAX_UPLOAD_BYTES=214748364800
# Scratch space for the worker. Needs room for the largest source file plus its proxy.
# WORK_DIR=/tmp/agent-edit-work
MEDIA_CONCURRENCY=3
PROXY_CONCURRENCY=1
RENDER_CONCURRENCY=1
# Burning in captions needs libass. On macOS: brew install ffmpeg-full
# FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe
